{
  "name": "helium-ui",
  "version": "2.6.4.1",
  "description": "Design system and component library for Starburst Labs, Inc.",
  "main": "dist/js/index",
  "types": "dist/js/index.d.ts",
  "repository": "git@github.com:starburstlabs/helium-ui.git",
  "author": [
    "Adam Grossi <adam.grossi@wealthbox.com>",
    "Eugene Cyckowski <eugene.cyckowski@wealthbox.com",
    "Jeffrey Bondorew <jeffrey.bondorew@wealthbox.com>",
    "JP Camara <jp.camara@wealthbox.com>",
    "Kevin Clark <kevin.clark@wealthbox.com>",
    "Michal Kopanski <michal.kopanski@wealthbox.com>",
    "Trevor Reiff <trevor.reiff@wealthbox.com>"
  ],
  "license": "MIT",
  "private": true,
  "browserslist": [
    "defaults",
    "not IE 11"
  ],
  "scripts": {
    "test": "NODE_ENV=test jest --verbose",
    "build": "yarn build:docs && rm -rf ./dist && NODE_ENV=production tsc",
    "build:docs": "yarn docs:clean && yarn docs:generate && yarn docs:prettify",
    "watch": "tsc --watch",
    "prettier:check": "prettier --check 'ts/**/*.{ts,js,tsx}'",
    "prettier:fix": "prettier --write 'ts/**/*.{ts,js,tsx}'",
    "eslint:check": "eslint --no-eslintrc -c .eslintrc.js 'ts/**/*.{ts,js,tsx}'",
    "eslint:fix": "eslint --no-eslintrc -c .eslintrc.js 'ts/**/*.{ts,js,tsx}' --fix",
    "stylelint:check": "stylelint --config stylelint.config.js 'scss/**/*.{scss,css}'",
    "stylelint:fix": "stylelint --config stylelint.config.js 'scss/**/*.{scss,css}' --fix",
    "stylelint:staged:check": "stylelint --config stylelint.config.js --allow-empty-input",
    "lint:staged": "lint-staged",
    "docs:generate": "mkdir docs && react-docgen \"./ts/components/**/*.ts(x)\" -i [\".ts/components/Portal.tsx\"] -o ./docs/components.json",
    "docs:prettify": "yarn prettier --write docs/components.json --plugin=prettier-plugin-sort-json",
    "docs:clean": "rm -rf ./docs"
  },
  "lint-staged": {
    "scss/**/*.{scss,css}": "yarn stylelint:staged:check"
  },
  "pre-commit": [
    "build",
    "lint:staged"
  ],
  "dependencies": {
    "@floating-ui/react": "^0.25.2",
    "@headlessui/react": "1.7.12",
    "bootstrap": "~5.1.3",
    "focus-trap": "^6.3.0",
    "html-react-parser": "^3.0.12",
    "react-dom": "^17.0.1",
    "react-transition-group": "^4.4.5",
    "react": "^17.0.1"
  },
  "devDependencies": {
    "@babel/plugin-proposal-class-properties": "^7.14.5",
    "@babel/plugin-syntax-dynamic-import": "^7.8.3",
    "@babel/plugin-transform-destructuring": "^7.14.7",
    "@babel/plugin-transform-regenerator": "^7.14.5",
    "@babel/plugin-transform-runtime": "^7.14.5",
    "@babel/preset-env": "^7.14.7",
    "@babel/preset-react": "^7.14.5",
    "@babel/preset-typescript": "^7.14.5",
    "@react-docgen/cli": "^2.0.1",
    "@testing-library/jest-dom": "^5.16.4",
    "@testing-library/react": "^12.0.0",
    "@testing-library/user-event": "^14.4.3",
    "@types/classnames": "^2.3.1",
    "@types/enzyme": "^3.10.8",
    "@types/jest": "^26.0.23",
    "@types/react-dom": "^17.0.0",
    "@types/react-test-renderer": "^17.0.1",
    "@types/react-transition-group": "^4.4.7",
    "@types/react": "^17.0.1",
    "@typescript-eslint/eslint-plugin": "^4.14.2",
    "@typescript-eslint/parser": "^4.14.2",
    "babel-jest": "^27.0.6",
    "babel-plugin-dynamic-import-node": "^2.3.3",
    "babel-plugin-macros": "^3.1.0",
    "babel-plugin-module-resolver": "^4.1.0",
    "enzyme-to-json": "^3.6.2",
    "enzyme": "^3.11.0",
    "eslint-config-prettier": "^7.2.0",
    "eslint-plugin-import": "^2.25.3",
    "eslint-plugin-jest-dom": "^4.0.1",
    "eslint-plugin-jsx-a11y": "^6.4.1",
    "eslint-plugin-prettier": "^4.0.0",
    "eslint-plugin-react-hooks": "^4.2.0",
    "eslint-plugin-react": "^7.22.0",
    "eslint-plugin-testing-library": "^5.0.4",
    "eslint": "^7.19.0",
    "jest": "^27.0.5",
    "jsdom": "^19.0.0",
    "lint-staged": "^10.2.4",
    "postcss": "8",
    "pre-commit": "^1.2.2",
    "prettier-plugin-sort-json": "^3.1.0",
    "prettier": "^3.0.0",
    "react-test-renderer": "^17.0.2",
    "stylelint-config-idiomatic-order": "^8.1.0",
    "stylelint-config-standard-scss": "^3.0.0",
    "stylelint-order": "^4.0.0",
    "stylelint": "^14.0.1",
    "svgo": "^3.0.2",
    "ts-node": "^10.0.0",
    "typescript": "^4.4.2"
  },
  "resolutions": {
    "@types/react": "^17.0.1"
  }
}
