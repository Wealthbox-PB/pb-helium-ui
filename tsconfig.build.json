{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "esnext",
    "esModuleInterop": true,
    "moduleResolution": "node",
    "sourceMap": true,
    "rootDir": "./ts",
    "outDir": "./dist/js",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,

    "declaration": true
  },
  "exclude": [
    "dist",
    "**/*.d.ts",
    "**/*.test.tsx",
    "**/*.story.tsx",
    "**/*.stories.tsx",
    "node_modules",
    "spec",
    "fonts",
    "stories",
    "storybook-static"
  ],
  "compileOnSave": false
}
