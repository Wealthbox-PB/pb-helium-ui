{
  "compilerOptions": {
    "noUnusedLocals": true,
    "noImplicitReturns": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "allowSyntheticDefaultImports": true,
    "strictNullChecks": true,

    "jsx": "react",
    "lib": ["dom", "esnext"],
    "baseUrl": ".",
    "paths": {
      "*": ["node_modules/*", "ts/*"]
    },
    "sourceMap": true,
    "target": "es5",
    "types": ["enzyme", "jest", "react", "react-dom", "react-test-renderer"]
  }
}
